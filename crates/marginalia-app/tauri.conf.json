{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marginalia",
  "version": "0.0.9",
  "identifier": "org.marginalia.reader",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Marginalia",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: mgimg: http://mgimg.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "license": "GPL-3.0-or-later",
    "resources": {
      "../../LICENSE": "licenses/LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "shortDescription": "EPUB/MOBI/PRC reader with text-to-speech",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB book",
        "description": "EPUB book",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": [
          "mobi",
          "prc",
          "azw"
        ],
        "name": "Mobipocket book",
        "description": "Mobipocket / Kindle book",
        "role": "Viewer",
        "mimeType": "application/x-mobipocket-ebook"
      },
      {
        "ext": [
          "azw3"
        ],
        "name": "Kindle book",
        "description": "Kindle KF8 book",
        "role": "Viewer",
        "mimeType": "application/vnd.amazon.mobi8-ebook"
      },
      {
        "ext": [
          "fb2"
        ],
        "name": "FictionBook",
        "description": "FictionBook book",
        "role": "Viewer",
        "mimeType": "application/x-fictionbook+xml"
      },
      {
        "ext": [
          "fbz"
        ],
        "name": "FictionBook (zipped)",
        "description": "Zipped FictionBook book",
        "role": "Viewer",
        "mimeType": "application/x-zip-compressed-fb2"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/marginalia.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/marginalia.desktop"
      }
    }
  }
}
